# Apache rules for the static site on SuperHosting (copied to out/ by `npm run build`).

# Send plain HTTP to HTTPS. Certificate renewal checks under /.well-known/ are left alone.
RewriteEngine On

# One address for the site: www.getnimble.bg goes to getnimble.bg.
RewriteCond %{HTTP_HOST} ^www.getnimble.bg$ [NC]
RewriteCond %{REQUEST_URI} !^/.well-known/
RewriteRule ^ https://getnimble.bg%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Use the site's own "not found" page.
ErrorDocument 404 /404.html

# The social preview image is exported without a file extension. Tell browsers it is a PNG.
<Files "opengraph-image">
  ForceType image/png
</Files>

# Text files (llms.txt, robots.txt) are UTF-8.
AddDefaultCharset UTF-8
